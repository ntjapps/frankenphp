# Site-wide security headers, imported into the Laravel Octane site block via
# CADDY_SERVER_EXTRA_DIRECTIVES (apps forward it through config/octane.php
# `caddy.env`). HSTS is deliberately absent: Cloudflare sets it at the edge.
# `?` only sets a header the app has not already set, so per-route headers
# (e.g. the stricter CSP on the OAuth consent screen) still win.
header {
	?X-Content-Type-Options "nosniff"
	?X-Frame-Options "SAMEORIGIN"
	?Referrer-Policy "strict-origin-when-cross-origin"
	?Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(self), usb=(), interest-cohort=()"
	?Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
	-Server
	-X-Powered-By
	defer
}

# Inbound WhatsApp media is sender-controlled content on the public disk. It is served
# only by the app's authenticated download route (whatsapp-media-download), never as a
# static file under /storage: answer 404 here, before php_server can serve the symlinked
# file. The regexp tolerates doubled slashes and any case.
@whatsappMedia path_regexp (?i)^/+storage/+whatsapp-media(/|$)
respond @whatsappMedia 404
