# Test-only Caddyfile: the site block of Laravel Octane's Caddyfile stub (laravel/octane
# src/Commands/stubs/Caddyfile) without the worker and Mercure parts. Used by test-paths.sh.
{
	admin off
	auto_https off
	frankenphp
	order php_server before file_server
}

:80 {
	route {
		root * /app/public
		encode zstd gzip

		{$CADDY_SERVER_EXTRA_DIRECTIVES}

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}
